---
/**
 * The SoNCA roundel, redrawn as vector so it stays crisp at every size and can
 * be recoloured for dark mode. Split ring (navy / eucalypt green), canopy,
 * account bars, and the water band beneath.
 */
import { uid } from '../lib/uid';

interface Props {
  size?: number;
  class?: string;
  title?: string;
}

const { size = 44, class: className, title } = Astro.props;
const decorative = !title;

/* The mark appears more than once per page (header and footer), so the clip
   path needs an id that is unique within the document. */
const clipId = uid('sonca-roundel');
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={title}
  focusable="false"
>
  {title && <title>{title}</title>}

  <defs>
    <clipPath id={clipId}>
      <circle cx="50" cy="50" r="40" />
    </clipPath>
  </defs>

  <!-- split ring -->
  <g fill="none" stroke-width="4" stroke-linecap="round">
    <path class="mark-navy-stroke" d="M38.61 92.5 A44 44 0 1 1 78.28 16.3" />
    <path class="mark-green-stroke" d="M83.71 21.72 A44 44 0 0 1 46.16 93.83" />
  </g>

  <g clip-path={`url(#${clipId})`}>
    <!-- trunk and branches -->
    <g class="mark-green-stroke-dark" fill="none" stroke-width="3.6" stroke-linecap="round">
      <path d="M31 64 V42" />
      <path d="M31 54 L24 46.5" />
      <path d="M31 48 L38 41" />
    </g>

    <!-- canopy -->
    <g class="mark-green-fill-dark">
      <ellipse cx="31" cy="45.5" rx="5.8" ry="3.1" />
      <ellipse cx="31" cy="37" rx="6" ry="3.2" />
      <ellipse cx="31" cy="28.5" rx="5.6" ry="3" />
    </g>
    <g class="mark-green-fill">
      <ellipse cx="22" cy="45" rx="5.8" ry="3.1" transform="rotate(-22 22 45)" />
      <ellipse cx="40" cy="44" rx="5.8" ry="3.1" transform="rotate(22 40 44)" />
      <ellipse cx="19.5" cy="37" rx="5.8" ry="3.1" transform="rotate(-34 19.5 37)" />
      <ellipse cx="43.5" cy="36.5" rx="5.8" ry="3.1" transform="rotate(34 43.5 36.5)" />
      <ellipse cx="23.5" cy="28" rx="5.6" ry="3" transform="rotate(-30 23.5 28)" />
      <ellipse cx="40" cy="28" rx="5.6" ry="3" transform="rotate(30 40 28)" />
      <ellipse cx="31" cy="20" rx="5" ry="2.8" />
    </g>

    <!-- account bars -->
    <g class="mark-navy-fill">
      <rect x="51" y="54" width="7" height="12" rx="0.8" />
      <rect x="61" y="47" width="7" height="19" rx="0.8" />
      <rect x="71" y="40" width="7" height="26" rx="0.8" />
    </g>

    <!-- water band -->
    <path
      class="mark-navy-fill"
      d="M0 67.5 C 22 63 44 68.5 64 69 C 80 69.3 92 67.5 100 65 L100 100 L0 100 Z"
    />
    <path
      class="mark-green-stroke"
      fill="none"
      stroke-width="2.6"
      stroke-linecap="round"
      d="M0 63.5 C 22 59.5 44 64.5 64 64.8 C 80 65 92 63.5 100 61"
    />

    <!-- ledger rules in the water -->
    <g class="mark-line-stroke" stroke-width="1.8" stroke-linecap="round">
      <path d="M26 75 H47" />
      <path d="M53 75 H74" />
      <path d="M32 83 H47" />
      <path d="M53 83 H68" />
      <path d="M50 71 V87" />
    </g>
  </g>
</svg>

<style>
  .logo-mark {
    --mark-navy: #12314f;
    --mark-green: #2c6b3f;
    --mark-green-dark: #1f4e2e;
    --mark-line: #fbf9f5;
    flex-shrink: 0;
  }

  :global(:root[data-theme='dark']) .logo-mark,
  :global(.site-footer) .logo-mark,
  :global(.section--inverse) .logo-mark {
    --mark-navy: #8fb4d4;
    --mark-green: #6fb98a;
    --mark-green-dark: #4f9c6b;
    --mark-line: #101c26;
  }

  .mark-navy-stroke {
    stroke: var(--mark-navy);
  }
  .mark-green-stroke {
    stroke: var(--mark-green);
  }
  .mark-green-stroke-dark {
    stroke: var(--mark-green-dark);
  }
  .mark-navy-fill {
    fill: var(--mark-navy);
  }
  .mark-green-fill {
    fill: var(--mark-green);
  }
  .mark-green-fill-dark {
    fill: var(--mark-green-dark);
  }
  .mark-line-stroke {
    stroke: var(--mark-line);
    fill: none;
  }

  @media print {
    .logo-mark {
      --mark-navy: #12314f;
      --mark-green: #2c6b3f;
      --mark-green-dark: #1f4e2e;
      --mark-line: #ffffff;
    }
  }
</style>
