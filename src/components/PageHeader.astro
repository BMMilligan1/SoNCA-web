---
import Motif from './Motif.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header">
  <div class="page-header__motif" aria-hidden="true">
    <Motif variant="strata" />
  </div>
  <div class="page page-header__inner">
    {eyebrow && <p class="eyebrow"><span class="eyebrow__rule" />{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead page-header__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem) clamp(2.5rem, 1.8rem + 3.5vw, 4rem);
    background-color: var(--c-panel);
    border-block-end: 1px solid var(--c-rule);
  }

  /* Hidden on narrow screens: stretched vertically the strata become arcs that
     compete with the heading rather than sitting behind it. */
  .page-header__motif {
    display: none;
  }

  @media (min-width: 48rem) {
    .page-header__motif {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
      inline-size: min(46%, 34rem);
      opacity: 0.5;
      -webkit-mask-image: linear-gradient(to left, #000 5%, transparent 92%);
      mask-image: linear-gradient(to left, #000 5%, transparent 92%);
      pointer-events: none;
    }
  }

  .page-header__inner {
    position: relative;
  }

  .page-header h1 {
    margin-block-start: var(--space-s);
    max-width: 20ch;
    font-size: var(--step-4);
  }

  .page-header__lead {
    margin-block-start: var(--space-m);
    color: var(--c-text-muted);
    max-width: var(--measure-narrow);
  }
</style>
