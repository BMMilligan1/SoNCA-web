---
interface Props {
  title?: string;
  /** `note` for context, `pending` for details still being confirmed. */
  tone?: 'note' | 'pending';
  class?: string;
}

const { title, tone = 'note', class: className } = Astro.props;
---

<aside class:list={['callout', `callout--${tone}`, className]}>
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    padding: var(--space-m) var(--space-l);
    border-inline-start: 2px solid var(--c-accent-soft);
    background-color: var(--c-panel);
    font-size: var(--step--1);
    color: var(--c-text-muted);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .callout--pending {
    border-inline-start-color: var(--c-highlight);
  }

  .callout__title {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-heading);
    margin-block-end: var(--space-2xs);
  }

  .callout--pending .callout__title {
    color: var(--c-highlight);
  }

  .callout__body :global(> * + *) {
    margin-block-start: var(--space-s);
  }
</style>
