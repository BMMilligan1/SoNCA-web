---
/** Light/dark toggle. Defaults to the visitor's system preference. */
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="18" height="18">
    <g class="theme-toggle__sun" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.1" />
      <path d="M12 2.6v2.2M12 19.2v2.2M21.4 12h-2.2M4.8 12H2.6M18.6 5.4l-1.6 1.6M7 17l-1.6 1.6M18.6 18.6L17 17M7 7L5.4 5.4" />
    </g>
    <path
      class="theme-toggle__moon"
      fill="currentColor"
      d="M20.3 14.6A8.6 8.6 0 0 1 9.4 3.7a8.6 8.6 0 1 0 10.9 10.9Z"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.35rem;
    block-size: 2.35rem;
    padding: 0;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-sm);
    background-color: transparent;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--c-heading);
    border-color: var(--c-rule-strong);
    background-color: var(--c-panel);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }
</style>

<script>
  const KEY = 'sonca-theme';

  function label(theme: string) {
    return theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
  }

  function sync() {
    const theme = document.documentElement.dataset.theme ?? 'light';
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((button) => button.setAttribute('aria-label', label(theme)));
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('[data-theme-toggle]');
    if (!button) return;
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* storage unavailable — the choice simply won't persist */
    }
    sync();
  });

  sync();
</script>
