---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import { links } from '../config/links';
import { site, incorporation } from '../config/site';

const title = 'Contact';
const lead = 'One address reaches the Society. Tell us what it is about and we will route it.';

const routes = [
  {
    heading: 'Membership',
    detail:
      'Questions about joining, concessions, renewals or your member record. If you are ready to join, use the membership form.',
    action: { label: 'Become a foundation member', href: links.join },
    secondary: { label: 'Membership detail', href: '/membership/' },
  },
  {
    heading: 'Events',
    detail:
      'The launch seminar, the online programme, the inaugural conference, or offering to deliver a session.',
    action: { label: 'Register your interest', href: links.expressInterest },
    secondary: { label: 'Events and get involved', href: '/events/' },
  },
  {
    heading: 'Technical work',
    detail:
      'The technical working group, the SEEA update, or a measurement question you think the Society should take up.',
    action: { label: 'Express interest', href: links.expressInterest },
    secondary: { label: 'Technical working group', href: '/technical-working-group/' },
  },
  {
    heading: 'Partnership',
    detail:
      'Sponsorship, event partnership, venue support or commissioned activities from organisations.',
    action: { label: 'Enquire about partnership', href: links.partnership },
    secondary: { label: 'Organisational partners', href: '/partners/' },
  },
  {
    heading: 'Concerns and privacy',
    detail:
      'Conduct in the Society’s activities, decisions of the Society itself, or how we have handled your personal information.',
    action: { label: 'Raise a concern', href: links.complaints },
    secondary: { label: 'How complaints are handled', href: '/complaints/' },
  },
  {
    heading: 'Press and general',
    detail: 'Anything else, including media enquiries about the Society and its launch.',
    action: { label: 'Write to us', href: links.contact },
    secondary: { label: 'About the Society', href: '/about/' },
  },
];
---

<Base title={title} description={lead}>
  <PageHeader title={title} eyebrow="Contact" lead={lead}>
    <p class="contact-email">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </PageHeader>

  <section class="section">
    <div class="page">
      <div class="grid grid--3">
        {
          routes.map((route) => (
            <article class="route">
              <h2 class="route__heading">{route.heading}</h2>
              <p class="route__detail">{route.detail}</p>
              <div class="route__actions">
                <Cta href={route.action.href} variant="arrow">
                  {route.action.label}
                </Cta>
                <Cta href={route.secondary.href} variant="arrow">
                  {route.secondary.label}
                </Cta>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="contact-meta">
        <h2>The Society</h2>
        <dl class="definition-list">
          <div>
            <dt>Legal name</dt>
            <dd>Society for Natural Capital Accounting</dd>
          </div>
          <div>
            <dt>Legal form</dt>
            <dd>Incorporated association under the {incorporation.act}</dd>
          </div>
          <div>
            <dt>Incorporation</dt>
            <dd>
              {
                incorporation.number
                  ? `No. ${incorporation.number}, ${incorporation.date}`
                  : `Application lodged ${incorporation.lodged}; certificate awaited`
              }
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {
            site.linkedin && (
              <div>
                <dt>LinkedIn</dt>
                <dd>
                  <a href={site.linkedin} rel="noopener">
                    Follow the Society
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-email {
    margin-block-start: var(--space-m);
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }

  .contact-email a {
    color: var(--c-link);
  }

  .route {
    padding-block-start: var(--space-m);
    border-block-start: 2px solid var(--c-rule-strong);
  }

  .route__heading {
    font-size: var(--step-1);
  }

  .route__detail {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .route__actions {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-3xs);
    margin-block-start: var(--space-m);
  }

  .contact-meta {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--c-rule);
    max-width: var(--width-page);
  }

  .contact-meta h2 {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin-block-end: var(--space-m);
  }
</style>
