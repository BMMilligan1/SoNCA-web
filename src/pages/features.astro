---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Cta from '../components/Cta.astro';
import { sortedFeatures, featureUrl, type Feature } from '../data/features';
import '../styles/features.css';

const title = 'Features';
const lead =
  'A changing spotlight on the people, publications, data and debates shaping natural capital accounting.';

const sorted = sortedFeatures();
const [current, ...past] = sorted;

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

const isBlock = (p: string) => ['<ul', '<ol', '<h3'].some((t) => p.startsWith(t));
const paras = (f: Feature) =>
  Array.isArray(f.body) ? f.body : [f.body ?? f.blurb];

/** In-page anchor for each past feature (kept so older links still land). */
const slug = (f: Feature) =>
  `feature-${f.date}-${f.title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .split('-')
    .slice(0, 5)
    .join('-')}`;
---

<Base title={title} description={lead}>
  <PageHeader title={title} eyebrow="From the Society" lead={lead} />

  {
    current && (
      <section class="section">
        <div class="page">
          <div class="feature-layout">
            <article class="feature-lead">
              <figure class="feature-lead__figure">
                <img src={current.image} alt={current.imageAlt} loading="lazy" />
                {current.imageCredit && (
                  <figcaption class="feature-lead__credit" set:html={current.imageCredit} />
                )}
              </figure>
              <div class="feature-lead__body">
                <p class="eyebrow">
                  <span class="eyebrow__rule" />This week
                </p>
                <h2 class="feature-lead__title"><a href={featureUrl(current)}>{current.title}</a></h2>
                <p class="feature-lead__meta">
                  by {current.author} &middot; {fmt(current.date)}
                </p>
                <div class="prose feature-lead__prose">
                  {paras(current).map((p) => (
                    isBlock(p) ? <Fragment set:html={p} /> : <p set:html={p} />
                  ))}
                </div>
                {current.link && (
                  <p class="feature-lead__more">
                    <Cta href={current.link} variant="arrow">
                      {current.linkLabel ?? 'Read more'}
                    </Cta>
                  </p>
                )}
              </div>
            </article>

            {past.length > 0 && (
              <aside class="feature-index" aria-labelledby="feature-index-title">
                <p class="eyebrow"><span class="eyebrow__rule" />Archive</p>
                <h2 class="feature-index__title" id="feature-index-title">Past features</h2>
                <ol class="feature-index__list">
                  {past.map((f) => (
                    <li class="feature-index__item">
                      <a class="feature-index__link" href={featureUrl(f)}>
                        <span class="feature-index__date">{fmt(f.date)}</span>
                        <span class="feature-index__name">{f.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </aside>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="section section--panel section--ruled">
        <div class="page">
          <SectionHeading eyebrow="Archive" title="Past features" />
          <div class="feature-archive">
            {past.map((f) => (
              <article class="feature-past" id={slug(f)}>
                <figure class="feature-past__figure">
                  <img src={f.image} alt={f.imageAlt} loading="lazy" />
                  {f.imageCredit && (
                    <figcaption class="feature-lead__credit" set:html={f.imageCredit} />
                  )}
                </figure>
                <div class="feature-past__body">
                  <h3 class="feature-past__title"><a href={featureUrl(f)}>{f.title}</a></h3>
                  <p class="feature-lead__meta">
                    by {f.author} &middot; {fmt(f.date)}
                  </p>
                  <div class="prose feature-past__prose">
                    {paras(f).map((p) => (
                      isBlock(p) ? <Fragment set:html={p} /> : <p set:html={p} />
                    ))}
                  </div>
                  {f.link && (
                    <p class="feature-lead__more">
                      <Cta href={f.link} variant="arrow">{f.linkLabel ?? 'Read more'}</Cta>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
