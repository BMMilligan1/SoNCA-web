---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/public-sans';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Omit the site name suffix (used on the home page). */
  bareTitle?: boolean;
  ogImage?: string;
}

const { title, description = site.description, bareTitle = false, ogImage = '/og-image.png' } =
  Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? site.url).href;
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10161c" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      (function () {
        try {
          var stored = localStorage.getItem('sonca-theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="print-header">
      <strong>Society for Natural Capital Accounting</strong> — {title}
      <br />
      <span>{canonical}</span>
    </div>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
